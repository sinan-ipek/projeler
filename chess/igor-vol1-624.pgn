[SetUp "1"]
[FEN "6br/8/8/8/8/8/8/R7 w - - 0 1"]
[Variant "KinglessExercise"]
[SourcePage "21"]
[Section "Rooks and Bishops / The pin"]
[Instruction "White to move: After which move by White does Black lose either the bishop or the rook, no matter what?"]
[BookAnswer "1. Ra8 (now one of the black pieces is forced to make a move, leaving the other piece under attack; for example: 1... Rh4 2. Rxg8)."]
[AnswerType "move"]
[FirstMoveUCI "a1a8"]

